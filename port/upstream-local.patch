+void fire_event(uint32_t type) {
+    if (type >= kEventTypes) return;
+    std::lock_guard lock(g_event_mutex);
+    if (g_event_callbacks[type].function == 0) return;
+    static const bool trace = std::getenv("TTT2_TRACE_EVENTS") != nullptr;
+    static int traced = 0;
